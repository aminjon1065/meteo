{
  "name": "@meteo/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Фоновые задачи метеопортала: синхронизации SmartMet/CAP/SILAM, расчёт индекса, уведомления, рассылки",
  "scripts": {
    "dev": "tsx watch src/index.ts | pino-pretty",
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "enqueue": "tsx scripts/enqueue.ts",
    "pull-source": "tsx scripts/pull-source.ts"
  },
  "dependencies": {
    "@meteo/core": "workspace:*",
    "@meteo/db": "workspace:*",
    "@meteo/i18n": "workspace:*",
    "basic-ftp": "^6.2.3",
    "better-auth": "^1.7.10",
    "bullmq": "^6.3.15",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "netcdfjs": "^4.0.0",
    "nodemailer": "^10.1.1",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "ssh2": "^1.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/ssh2": "^1.15.6",
    "esbuild": "^0.27.5",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "5.0.4"
  }
}
