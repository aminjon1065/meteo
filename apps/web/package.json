{
  "name": "@meteo/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Публичный портал, административная панель и JSON API метеопортала (Next.js)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lhci": "lhci autorun --config=lighthouserc.cjs",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@meteo/core": "workspace:*",
    "@meteo/db": "workspace:*",
    "@meteo/i18n": "workspace:*",
    "@meteo/ui": "workspace:*",
    "@protomaps/basemaps": "^5.7.2",
    "better-auth": "^1.7.10",
    "bullmq": "^6.3.15",
    "echarts": "^6.1.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.57.0",
    "maplibre-gl": "^6.14.0",
    "next": "16.4.1",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "pmtiles": "^4.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "5.0.4"
  }
