{
  "portalUrl": "https://portal.meteo.tj",
  "stationCode": "DU-01",
  "apiKeyEnv": "METEO_STATION_API_KEY",
  "watchDir": "C:\\AirMonitor\\Export",
  "filePattern": "*.csv",
  "pollIntervalSec": 60,
  "stateFile": "station-agent.state.json",
  "logFile": "station-agent.log",
  "mapping": {
    "delimiter": ";",
    "encoding": "utf-8",
    "headerRow": 1,
    "layout": "wide",
    "time": { "column": "Дата/время", "format": "DD.MM.YYYY HH:mm", "timezone": "Asia/Dushanbe" },
    "pollutants": {
      "PM2.5": { "column": "PM2.5 (мкг/м3)" },
      "PM10": { "column": "PM10 (мкг/м3)" },
      "NO2": { "column": "NO2 (мкг/м3)" },
      "SO2": { "column": "SO2 (мкг/м3)" },
      "CO": { "column": "CO (мг/м3)", "unit": "mg/m³" },
      "O3": { "column": "O3 (мкг/м3)" }
    },
    "statusColumn": "Статус",
    "invalidStatuses": ["CAL", "ERR", "MAINT"],
    "missingValues": ["", "-", "-999", "NaN"]
  }
}
