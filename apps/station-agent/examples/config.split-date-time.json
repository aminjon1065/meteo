{
  "portalUrl": "https://portal.meteo.tj",
  "stationCode": "DU-02",
  "apiKeyEnv": "METEO_STATION_API_KEY",
  "watchDir": "C:\\Data\\Daily",
  "filePattern": "????-??-??.csv",
  "pollIntervalSec": 300,
  "mapping": {
    "delimiter": ";",
    "encoding": "windows-1251",
    "headerRow": 2,
    "layout": "wide",
    "time": {
      "dateColumn": "Дата",
      "timeColumn": "Время",
      "format": "DD.MM.YYYY",
      "timeFormat": "HH:mm",
      "timezone": "Asia/Dushanbe"
    },
    "pollutants": {
      "PM25": { "column": "PM2.5, мкг/м3" },
      "PM10": { "column": "PM10, мкг/м3" },
      "CO": { "column": "CO, мг/м3", "unit": "mg/m³" }
    },
    "missingValues": ["", "н/д"]
  }
}
