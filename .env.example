# ---------------------------------------------------------------------------
# Метеопортал — переменные окружения (скопируйте в .env; .env не коммитится)
# ---------------------------------------------------------------------------

# PostgreSQL (TimescaleDB + PostGIS). Для локальной разработки — infra/compose/docker-compose.yml
DATABASE_URL=postgres://meteo:meteo@localhost:5432/meteo

# Redis (очереди BullMQ, кэш, rate limiting)
REDIS_URL=redis://localhost:6379

# better-auth: секрет ≥ 32 символов (openssl rand -base64 48) и публичный адрес приложения
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Первый администратор (используется один раз при pnpm db:seed, если пользователей ещё нет)
SEED_ADMIN_EMAIL=admin@meteo.tj
SEED_ADMIN_PASSWORD=ChangeMe-12345
SEED_ADMIN_NAME=Администратор

# Файлы: тайлы карты, временные файлы импорта и загрузки CMS (по умолчанию infra/data/tiles,
# data/imports и data/uploads в монорепо; в продакшене — тома /app/tiles, /app/uploads)
# TILES_DIR=/app/tiles
# IMPORTS_DIR=/app/data/imports
# UPLOADS_DIR=/app/uploads

# Почта: SMTP для уведомлений и подписок; без SMTP_URL письма пишутся в лог worker'а (режим разработки)
# SMTP_URL=smtp://user:password@mail.meteo.tj:587
MAIL_FROM="Метеопортал <noreply@meteo.tj>"

# Прогноз погоды: SmartMet Server (плагин timeseries). По умолчанию — открытые данные FMI
# (глобальная модель ECMWF, producer=ecmwf, без SmartSymbol). Для сервера Агентства:
# SMARTMET_URL=https://smartmet.meteo.tj  и, при необходимости, SMARTMET_PRODUCER=<producer>, SMARTMET_API_KEY=…
SMARTMET_URL=https://opendata.fmi.fi
# SMARTMET_PRODUCER=ecmwf
# SMARTMET_API_KEY=
# SMARTMET_HOURLY_STEPS=72
# SMARTMET_DAILY_DAYS=10

# Прогноз качества воздуха SILAM: THREDDS NetCDF Subset Service FMI и каталог PNG-слоёв (общий том web/worker)
SILAM_NCSS_URL=https://thredds.silam.fmi.fi/thredds/ncss/grid/
SILAM_DATASET=silam_glob_v6_1_sfc/silam_glob_v6_1_sfc_best.ncd
# SILAM_DIR=/app/silam
# SILAM_KEEP_RUNS=3

# Предупреждения CAP (SmartMet Alert): Atom/RSS-фид, HTTP-каталог XML или file://… с фикстурами.
# Адрес редактора Агентства уточняется (D3); без значения задача cap-sync пропускается.
# CAP_FEED_URL=https://alert.meteo.tj/cap/feed.atom
# CAP_FEED_URL=file:///abs/path/to/meteo/infra/data/cap/feed.atom
# CAP_TIMEOUT_MS=15000

# Безопасность web (docs/security-checklist.md): лимиты запросов на IP в минуту для /api/v1 и /api/auth
# (0 — выключить, например для нагрузочных проверок); кому разрешено встраивать виджеты /embed/* в iframe.
# RATE_LIMIT_API_PER_MINUTE=120
# RATE_LIMIT_AUTH_PER_MINUTE=30
# RATE_LIMIT_SUBSCRIBE_PER_MINUTE=10
# EMBED_FRAME_ANCESTORS=https://meteo.tj https://*.meteo.tj

# Приём данных станций (docs/02-architecture.md §8.4): отдельный лимит POST /api/v1/ingest/{code}
# (запросов в минуту на станцию + IP); ключ шифрования паролей источников SFTP/FTP/HTTP в карточке
# станции (openssl rand -base64 32; без значения используется BETTER_AUTH_SECRET — при его смене
# пароли источников придётся ввести заново); таймаут, предел размера файла и глубина первого прохода
# pull-адаптера; через сколько минут без данных по API (логгер/агент) писать администраторам.
# RATE_LIMIT_INGEST_PER_MINUTE=60
# STATION_SOURCES_KEY=
# STATION_PULL_TIMEOUT_MS=30000
# STATION_PULL_MAX_FILE_MB=20
# STATION_PULL_LOOKBACK_DAYS=7
# STATION_INGEST_STALE_MIN=180

# Worker
WORKER_PORT=3001
WORKER_CONCURRENCY=4
LOG_LEVEL=info
# Устойчивость интеграций (worker): сбоев подряд до письма администраторам и до размыкания цепи
# (circuit breaker), пауза после размыкания и её максимум (минуты); дополнительные адреса уведомлений.
# INTEGRATION_ALERT_FAILURES=3
# INTEGRATION_CIRCUIT_FAILURES=3
# INTEGRATION_CIRCUIT_COOLDOWN_MIN=30
# INTEGRATION_CIRCUIT_MAX_COOLDOWN_MIN=240
# ADMIN_ALERT_EMAILS=duty@meteo.tj,it@meteo.tj

# Продакшен (infra/compose/compose.prod.yml)
SITE_ADDRESS=portal.meteo.tj
POSTGRES_PASSWORD=change-me-strong-db-password
IMAGE_TAG=latest
# Бэкапы (infra/backup/run.sh): пароль репозитория restic (без него — только pg_dump + tar в том backups),
# время ежедневного запуска (UTC; 21:00 = 02:00 по Душанбе), хранение. Офсайт: RESTIC_REPOSITORY=s3:https://…/bucket
# + RESTIC_AWS_ACCESS_KEY_ID / RESTIC_AWS_SECRET_ACCESS_KEY. Пароль restic хранить отдельно от сервера!
# RESTIC_PASSWORD=change-me-restic-repository-password
# RESTIC_REPOSITORY=/backups/restic
# BACKUP_TIME_UTC=21:00
# BACKUP_KEEP_DAYS=30
# BACKUP_KEEP_DAILY=30
# BACKUP_KEEP_MONTHLY=12
