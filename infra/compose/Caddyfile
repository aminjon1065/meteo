# Caddy: TLS (Let's Encrypt автоматически), сжатие, заголовки безопасности, статика, прокси.
# Два режима (docs/runbook.md §13):
#  - один хост — CADDY_SITE_ADDRESS = домен портала, Caddy сам выпускает сертификат на 80/443;
#  - за общим обратным прокси (compose.edge.yml) — CADDY_SITE_ADDRESS = ":80", TLS завершает
#    общий Caddy, а этот слушает HTTP только во внутренней сети edge.
{
	email admin@meteo.tj
	# Заголовки X-Forwarded-* принимаются только от прокси из частных сетей (общий Caddy в сети
	# Docker). От клиентов из интернета они перезаписываются адресом TCP‑соединения.
	servers {
		trusted_proxies static private_ranges
	}
}

{$CADDY_SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=()"
		-Server
	}

	# Векторные тайлы карты (PMTiles, range-запросы) — кэш сутки
	handle_path /tiles/* {
		root * /srv/tiles
		header Cache-Control "public, max-age=86400"
		header Access-Control-Allow-Origin "*"
		file_server
	}

	# Растровые слои SILAM — кэш час
	handle_path /silam/* {
		root * /srv/silam
		header Cache-Control "public, max-age=3600"
		file_server
	}

	# Загрузки CMS (изображения новостей, PDF). Файлы проверены по сигнатуре при загрузке;
	# документы с активным содержимым (PDF) отдаются только как вложение, а не в origin портала.
	handle_path /uploads/* {
		root * /srv/uploads
		header Cache-Control "public, max-age=604800"
		header Content-Security-Policy "default-src 'none'; sandbox"
		@pdf path *.pdf
		header @pdf Content-Disposition attachment
		file_server
	}

	handle {
		# X-Forwarded-Proto Caddy ставит сам: схема соединения или (от доверенного прокси) присланное
		# им значение — за общим прокси это https, хотя сюда запрос приходит по HTTP.
		reverse_proxy web:3000 {
			# IP клиента для лимитов запросов и журнала аудита (web доверяет первому адресу
			# X-Forwarded-For): адрес TCP‑соединения, а за доверенным прокси — переданный им адрес
			# клиента. Значение, присланное самим клиентом, не принимается.
			header_up X-Forwarded-For {client_ip}
			header_up X-Real-IP {client_ip}
		}
	}

	log {
		output stdout
		format json
	}
}
